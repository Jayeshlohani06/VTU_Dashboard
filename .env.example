# ============================================
# VTU Dashboard — Environment Configuration
# Copy this file as .env and fill in values.
# ============================================

# --------------- Server ---------------
PORT=10000
DEBUG=false
HOST=0.0.0.0

# --------------- Logging ---------------
LOG_LEVEL=INFO

# --------------- Caching ---------------
CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=3600
CACHE_THRESHOLD=500

# --------------- Security ---------------
SECRET_KEY=change-me-to-a-random-string
MAX_UPLOAD_SIZE_MB=10
RATE_LIMIT_FEEDBACK=5

# --------------- Google Sheets ---------------
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID
GOOGLE_CREDENTIALS=

# --------------- Feature Flags ---------------
ENABLE_FEEDBACK=true
ENABLE_TOUR=true
